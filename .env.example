# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=koe
POSTGRES_PORT=5432

# Application Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/koe
PORT=3000
HOST=0.0.0.0

# Authentication Configuration
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
# SESSION_SECRET=replace-with-a-separate-long-random-string (defaults to JWT_SECRET)

# Admin UI (optional; defaults to ../../../apps/admin/dist relative to the server)
# ADMIN_DIST_PATH=/app/apps/admin/dist

# Google OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/google/callback
# CLIENT_ORIGIN=http://localhost:5173

# Discord OAuth (optional)
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/discord/callback

# Reverse proxy trust (optional; unset ignores X-Forwarded-For and uses the socket peer)
# TRUST_PROXY=127.0.0.1
# TRUST_PROXY_ALLOW_UNBOUNDED=true

# Rate limiting (optional; defaults shown)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_COMMENTS=10
RATE_LIMIT_VOTES=60
RATE_LIMIT_REACTIONS=60
DUPLICATE_COMMENT_WINDOW_MS=30000

# Webhooks (optional). JSON array of { url, secret, events, active? }.
# WEBHOOK_SUBSCRIPTIONS=[{"url":"https://example.com/hooks","secret":"change-me","events":["comment.created"]}]
# WEBHOOK_TIMEOUT_MS=10000
